FROM node:22-alpine AS web-builder
RUN corepack enable
WORKDIR /src
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
RUN pnpm --dir apps/web run build

FROM golang:1.26-alpine AS api-builder
WORKDIR /src
COPY services/api/go.mod ./
COPY services/api ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/video-api ./cmd/server

FROM alpine:3.22
RUN addgroup -S app && adduser -S -G app app \
    && mkdir -p /app/web /data \
    && chown -R app:app /app /data
COPY --from=api-builder /out/video-api /app/video-api
COPY --from=web-builder /src/apps/web/dist /app/web
USER app
ENV API_ADDR=0.0.0.0:8080 \
    DATA_DIR=/data \
    WEB_DIST=/app/web \
    WORKER_URL=http://worker:8090
EXPOSE 8080
VOLUME ["/data"]
ENTRYPOINT ["/app/video-api"]

