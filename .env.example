# Go API
API_ADDR=127.0.0.1:8080
WORKER_URL=http://127.0.0.1:8090
DATA_DIR=./data
WEB_DIST=./apps/web/dist

# Python worker / JusuanHub. Copy this file to .env and fill VIDEO_API_KEY.
WORKER_ADDR=127.0.0.1
WORKER_PORT=8090
WORKER_PUBLIC_URL=http://127.0.0.1:8090
VIDEO_API_BASE_URL=https://api.jusuanhub.com:10443
VIDEO_API_SUBMIT_PATH=/v1/media/generations
VIDEO_API_JOB_PATH_TEMPLATE=/v1/jobs/{id}?model={model}
VIDEO_API_ASSET_PATH_TEMPLATE=/v1/assets/{asset_id}/content?model={model}
VIDEO_API_KEY=
VIDEO_API_POLL_INTERVAL_SECONDS=3
VIDEO_API_TIMEOUT_SECONDS=900
VIDEO_API_REQUEST_TIMEOUT_SECONDS=300
